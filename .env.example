# Supabase Auth project API origin and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key for validated draft mutations.
SUPABASE_SECRET_KEY=

# Server-only Cloudflare R2 credentials scoped to the private draft media bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Razorpay Test Mode. Use the same test key ID in both key ID variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Dedicated server-only signing secret for the Razorpay Test Mode webhook.
RAZORPAY_WEBHOOK_SECRET=

# Enable test checkout information on staging only.
CHECKOUT_STAGING_POLICIES=
CHECKOUT_SUPPORT_EMAIL=

# Opt in on a local review server with the approved candidate files installed.
YUGMA_STOREFRONT_PHOTO_PREVIEW=
# Optional verified customer-facing support mailbox.
STOREFRONT_SUPPORT_EMAIL=

# Enable the test-receipt publish flow on the staging deployment.
STAGING_INVITATION_PUBLISHING=false
# Exact public origin for canonical links and email confirmation.
SITE_URL=
